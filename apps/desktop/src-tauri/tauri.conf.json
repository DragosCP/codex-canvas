{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Desktop P03",
  "version": "0.0.0",
  "identifier": "com.openai.codex.desktop.p03",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build",
    "devUrl": "http://127.0.0.1:4317",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 520,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
